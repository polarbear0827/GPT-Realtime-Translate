    "ja": { "label": "日本語", "lang": "ja", "cjk": true },
    "ko": { "label": "한국어", "lang": "ko", "cjk": false },
    "es": { "label": "Español", "lang": "es", "cjk": false },
    "fr": { "label": "Français", "lang": "fr", "cjk": false },
    "de": { "label": "Deutsch", "lang": "de", "cjk": false },
    "pt": { "label": "Português", "lang": "pt", "cjk": false },
    "it": { "label": "Italiano", "lang": "it", "cjk": false },
    "ru": { "label": "Русский", "lang": "ru", "cjk": false },
    "hi": { "label": "हिन्दी", "lang": "hi", "cjk": false },
