// Cloudflare Worker that relays live captions from the Keynote Live Translator app to audience phones.
// Deploy with `npm run relay:deploy` from the repository root (see README → 分享給觀眾).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klt-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // The Workers Free plan only offers SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
